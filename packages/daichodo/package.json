{
  "name": "daichodo",
  "version": "0.1.0",
  "description": "Official TypeScript client for the Daichodo API: Japanese qualified invoice issuer (\u9069\u683c\u8acb\u6c42\u66f8\u767a\u884c\u4e8b\u696d\u8005) and corporate number (\u6cd5\u4eba\u756a\u53f7) lookup, validation, and change detection.",
  "keywords": [
    "\u6cd5\u4eba\u756a\u53f7",
    "\u9069\u683c\u8acb\u6c42\u66f8",
    "\u30a4\u30f3\u30dc\u30a4\u30b9",
    "japan",
    "compliance",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichodo/daichodo-node.git",
    "directory": "packages/daichodo"
  },
  "homepage": "https://daichodo.com",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.10.0"
  }
}
