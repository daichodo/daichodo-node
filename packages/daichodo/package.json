{
  "name": "daichodo",
  "version": "0.1.0",
  "description": "Official TypeScript client for the Daichodo API: Japanese qualified invoice issuer (適格請求書発行事業者) and corporate number (法人番号) lookup, validation, and change detection.",
  "keywords": [
    "法人番号",
    "適格請求書",
    "インボイス",
    "japan",
    "compliance",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichodo/daichodo-node.git",
    "directory": "packages/daichodo"
  },
  "homepage": "https://daichodo.com",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.10.0"
  },
  "module": "./dist/index.js"
}
